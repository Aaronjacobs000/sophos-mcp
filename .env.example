# Sophos Central API Credentials
SOPHOS_CLIENT_ID=your-client-id
SOPHOS_CLIENT_SECRET=your-client-secret

# Server config
PORT=3100
TRANSPORT=http

# Optional. HTTP bind address. 0.0.0.0 lets other machines connect; set MCP_HTTP_TOKEN when you do.
# MCP_HTTP_HOST=127.0.0.1
# Optional. Every /mcp request must then send "Authorization: Bearer <token>".
# MCP_HTTP_TOKEN=
# Optional. Comma separated browser origins allowed besides localhost (browser based clients only).
# MCP_ALLOWED_ORIGINS=

# Optional. Sophos Fusion GraphQL endpoint (default shown). Override when the Fusion branded hostnames ship.
# SOPHOS_FUSION_GRAPHQL_URL=https://api.taegis.sophos.com/graphql
